# EgoKey settings
# EGOKEY_URL=https://example.tld/
# CHERRYPICK_URL remains supported for existing deployments.

# db settings
POSTGRES_PASSWORD=example-egokey-pass
# DATABASE_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_USER=example-egokey-user
# DATABASE_USER=${POSTGRES_USER}
POSTGRES_DB=cherrypick
# DATABASE_DB=${POSTGRES_DB}
DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}"
